{
  "name": "obscuro-chess",
  "version": "1.0.0",
  "description": "A fog-of-war chess AI: the Obscuro equilibrium search (vendored obscuro-ai) with a Stockfish leaf evaluator, an exact belief over every position still consistent with what a player has seen, and a fitted move prior over it.",
  "type": "module",
  "license": "MIT",
  "author": "opowell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opowell/obscuro-chess.git"
  },
  "homepage": "https://github.com/opowell/obscuro-chess#readme",
  "bugs": {
    "url": "https://github.com/opowell/obscuro-chess/issues"
  },
  "keywords": [
    "chess",
    "fog-of-war",
    "dark-chess",
    "game-ai",
    "imperfect-information",
    "counterfactual-regret-minimization",
    "stockfish",
    "belief-state"
  ],
  "main": "./src/index.js",
  "bin": {
    "obscuro-chess": "./bin/obscuro-chess.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./game": "./src/FogChess.js",
    "./stockfish": "./src/stockfish.js",
    "./config": "./src/config.js",
    "./presets": "./src/presets.js",
    "./vendor/stockfish/*": "./vendor/stockfish/*"
  },
  "files": [
    "bin",
    "src",
    "vendor/stockfish",
    "vendor/obscuro/src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "obscuro-chess": "node bin/obscuro-chess.js",
    "config": "node bin/obscuro-chess.js config",
    "demo": "node bin/obscuro-chess.js demo",
    "calibrate": "node bin/obscuro-chess.js calibrate",
    "fit-prior": "node bin/obscuro-chess.js fit-prior",
    "adopt-corpus": "node bin/obscuro-chess.js adopt-corpus",
    "move-quality": "node bin/obscuro-chess.js move-quality",
    "strength": "node bin/obscuro-chess.js strength"
  },
  "dependencies": {},
  "devDependencies": {}
}
